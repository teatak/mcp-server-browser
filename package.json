{
  "name": "@teatak/mcp-server-browser",
  "version": "0.0.1",
  "description": "MCP (Model Context Protocol) server that runs in the browser. Register tools and prompts on the page; expose them to a local MCP client (e.g. an agent) over WebSocket.",
  "license": "MIT",
  "author": "yangglive <yanggliveus@gmail.com>",
  "homepage": "https://github.com/teatak/mcp-server-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teatak/mcp-server-browser.git"
  },
  "bugs": {
    "url": "https://github.com/teatak/mcp-server-browser/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "websocket",
    "agent",
    "tools",
    "llm"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
